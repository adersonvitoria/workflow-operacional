// Schema do Workflow Operacional — PostgreSQL (Neon)
// Campos de consulta ficam em colunas; estruturas aninhadas (materiais,
// checklist, histórico, gates) ficam em JSON (jsonb), espelhando os modelos
// de `src/types`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — usado em runtime/serverless
  directUrl = env("DIRECT_URL")   // conexão direta — usada nas migrações
}

enum Perfil {
  COORDENADOR
  SUPERVISOR_TECNICO
  SUPERVISOR_MONITORAMENTO
  COMERCIAL
  ADMINISTRATIVO
  ASSISTENTE_1
  ASSISTENTE_2
  ALMOXARIFADO
  SUPRIMENTOS
  MEDICAO
}

enum Fluxo {
  IMPLANTACAO
  MANUTENCAO
  COMPRAS
}

enum CardStatus {
  EM_ANDAMENTO
  AGUARDANDO_APROVACAO
  CONCLUIDO
  FINALIZADO
  TRAVADO
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum Modalidade {
  LOCACAO
  VENDA
}

enum Natureza {
  INVESTIMENTO
  DESPESA
  ESTOQUE
}

model Item {
  id        String   @id @default(cuid())
  descricao String   @unique
  unidade   String   @default("un")
  preco     Float    @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoTecnico {
  TECNICO
  TERCEIRO // prestador de serviços
}

// Técnicos/auxiliares de campo (não acessam a plataforma). Cadastrados pelo
// Coordenador e oferecidos como lista nos campos Técnico/Auxiliar dos cards.
// `tipo` separa técnicos próprios de prestadores de serviços (terceiros).
model Tecnico {
  id        String      @id @default(cuid())
  nome      String
  tipo      TipoTecnico @default(TECNICO)
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Permissões editáveis por perfil (somente Coordenador edita). Quando um perfil
// não tem linha aqui, valem os padrões em código (CONFIG_PADRAO de lib/perfis).
model PerfilConfig {
  perfil      Perfil   @id
  etapas      Json     @default("[]") // EtapaId[] que o perfil executa/edita
  capacidades Json     @default("{}") // flags: criar/editar/excluir cards, relatórios, itens, usuários
  acoes       Json     @default("[]") // string[] de ações descritivas
  updatedAt   DateTime @updatedAt
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  id     String     @id @default(cuid())
  codigo String
  fluxo  Fluxo
  etapa  String
  status CardStatus @default(EM_ANDAMENTO)

  prioridade Prioridade  @default(NORMAL)
  modalidade Modalidade?
  natureza   Natureza?

  // Manutenção: orçamento complementar gerado a partir da Execução. Segue o
  // fluxo normal até Aprovado; depois do Aprovado só pode ir para Encerrados.
  complementar Boolean @default(false)

  // Implantação: card voltou do Suprimentos para o Almoxarifado conferir o
  // material recebido. Liga a tag "Conferência"; desliga ao ir p/ Monitoramento.
  conferenciaSuprimentos Boolean @default(false)

  clienteNome      String
  clienteDocumento String?
  clienteContato   String?
  clienteEndereco  String?
  clienteTipo      String?

  cr              String?
  cc              String?
  chamado         String?
  numeroOrcamento String?
  numeroConta     String?
  regiao          String? // região do atendimento (Implantação) — espelha a da Manutenção

  // Implantação · CRs por modalidade (substituem o CR único no formulário).
  // Locação: monitoramento + locação · Venda: serviço + material.
  crMonitoramento String?
  crLocacao       String?
  crServico       String?
  crMaterial      String?
  crMensalidade   String? // Venda: CR de mensalidade

  // Implantação: perguntas básicas (comuns a Locação e Venda). Cada flag, quando
  // ligada, habilita o respectivo número.
  temContrato         Boolean @default(false) // "Contrato?"  → chamado (Nº do chamado)
  crDedicado          Boolean @default(false) // "CR dedicado?" → cr (Nº do CR)
  temInvestimento     Boolean @default(false) // "Investimento?" → chamadoInvestimento
  chamadoInvestimento String? // Nº do chamado de investimento

  valorMaoDeObra    Float?
  valorEquipamentos Float?
  valorTotal        Float?
  valorMensal       Float?
  valorLocacao      Float? // Locação: valor de locação (além da mensalidade)
  margemVenda       Float? // Venda: % de margem aplicada sobre os itens (equipamentos)
  pagamento         Json?

  responsavelSetor   String?
  responsavelPessoa  String?

  dataAbertura           DateTime @default(now())
  dataAprovacao          DateTime?
  dataPrevisaoInstalacao DateTime?
  dataConclusao          DateTime?

  // Implantação · Técnica-Execução: período em que a equipe está em campo
  // (o card aparece no calendário durante todo o intervalo) + equipe e chip.
  dataInicioExecucao DateTime?
  dataFimExecucao    DateTime?
  tecnicos           String? // técnico da execução (lista de técnicos/prestadores)
  auxiliarTecnico    String? // auxiliar técnico da execução (mesma lista)
  numeroChip         String? // Nº do chip instalado

  // Gates e estruturas aninhadas (jsonb)
  aprovacaoInicial Json?
  auditoriaFinal   Json?
  medicao          Json?
  almoxarifado     Json?
  sigma            Json?
  manutencao       Json?
  materiais        Json @default("[]")
  checklist        Json @default("[]")
  historico        Json @default("[]")
  itensCompra      Json @default("[]") // Compras: itens do orçamento (card por orçamento)

  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fluxo, etapa])
}
