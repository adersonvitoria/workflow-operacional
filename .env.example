# Neon Postgres. Pegue em neon.tech ou na aba Storage do Vercel.
# DATABASE_URL = conexão POOLED (com -pooler) — usada em runtime/serverless.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL = conexão DIRETA (sem -pooler) — usada pelas migrações (prisma migrate).
DIRECT_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar o JWT de sessão (gere uma string aleatória longa).
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-grande"
